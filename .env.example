# Copy to .env (which git ignores):  cp .env.example .env
# Dev-only values. Never reuse them anywhere real.

# Keycloak's first "master" admin. Read ONLY when the database is empty
# (the very first start). Changing them afterwards has no effect.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-dev-only

# Password for Keycloak's own Postgres database.
POSTGRES_PASSWORD=keycloak-dev-only

# Secret for the `lab-provisioner` service account that scripts/configure.py
# signs in with. configure.py creates that client with this exact secret.
LAB_PROVISIONER_SECRET=provisioner-dev-only-change-me
